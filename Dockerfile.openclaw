# Dockerfile for running OpenClaw + SkellyBot together
FROM node:20-slim

# Install OpenClaw globally
RUN npm install -g openclaw

# Copy SkellyBot code
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY . .

# Expose ports
EXPOSE 3000
EXPOSE 18789

# Start script that runs both
COPY start-both.sh /start-both.sh
RUN chmod +x /start-both.sh

CMD ["/start-both.sh"]
